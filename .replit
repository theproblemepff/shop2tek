language = "python3"
modules = ["python-3.12"]
run = "python run.py"

[deployment]
build = ["pip", "install", "-r", "requirements.txt"]
run = ["python", "run.py"]

[[ports]]
localPort = 8000
externalPort = 80

[env]
PANEL_HOST = "0.0.0.0"
PANEL_PORT = "8000"
PANEL_COOKIE_SECURE = "1"
PANEL_IP_HEADER = "x-forwarded-for"
